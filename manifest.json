{
  "manifest_version": 3,
  "name": "NFX Mask",
  "version": "1.0.0",
  "description": "Browser wallet for NFX Blockchain",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NFX Mask"
  },
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content.js"]
  }],
  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [{
    "resources": ["src/nfx-provider.js"],
    "matches": ["<all_urls>"]
  }]
}