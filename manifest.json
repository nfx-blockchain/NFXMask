{
  "manifest_version": 3,
  "name": "NFX Wallet",
  "version": "1.0.0",
  "description": "Browser wallet for NFXBlockchain",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NFX Wallet"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background/background.js"
  },
  "web_accessible_resources": [{
    "resources": ["../nfx-dapp-provider/dist/nfx-provider.min.js"],
    "matches": ["<all_urls>"]
  }]
}